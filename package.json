{
	"name": "dsh-reasoning-presets",
	"version": "1.4.2",
	"description": "修好 DSH 里「选不了推理等级」的模型：按 pi-ai 目录与厂商家族规则补齐 llm-pi-ai 的 reasoningEfforts / compat / 默认档，并把模型菜单的「推理等级」那一行变成可拖动滑条。",
	"type": "module",
	"main": "./lib/index.mjs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tancy9527/dsh-reasoning-presets.git"
	},
	"homepage": "https://github.com/tancy9527/dsh-reasoning-presets#readme",
	"bugs": {
		"url": "https://github.com/tancy9527/dsh-reasoning-presets/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./lib/index.mjs",
		"./cli": "./bin/cli.mjs",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"bin": {
		"dsh-reasoning": "./bin/cli.mjs"
	},
	"files": [
		"lib",
		"bin",
		"docs",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node --test test/"
	},
	"dependencies": {
		"yaml": "^2.9.0"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true
		},
		"engines": {
			"dsh": ">=2.0.0"
		}
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"reasoning-effort",
		"thinking-level",
		"reasoning",
		"thinking",
		"slider",
		"ui",
		"pi-ai",
		"glm",
		"llm",
		"cli",
		"ci",
		"config-audit"
	],
	"license": "MIT"
}
